# Load alongside sdkconfig.defaults after adding the Morse Micro HaLow component.
CONFIG_MM_CHIP_MM6108=y
CONFIG_MM_BCF_FILE="bcf_fgh100mabmd.bin"
CONFIG_MM_BUSY=-1
# CONFIG_HALOW_PS_MODE is not set
CONFIG_MM_SPI_SCK=5
CONFIG_MM_SPI_MISO=4
CONFIG_MM_SPI_MOSI=6
CONFIG_MM_SPI_CS=20
CONFIG_MM_SPI_IRQ=19
CONFIG_MM_RESET_N=2
CONFIG_MM_WAKE=-1
CONFIG_HALOW_COUNTRY_CODE="CA"
CONFIG_MBEDTLS_NIST_KW_C=y
